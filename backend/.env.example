# Django
SECRET_KEY=pon-una-clave-larga-y-aleatoria
DEBUG=True
# En producción DEBE incluir tu dominio: tucuenta.pythonanywhere.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend servido localmente
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Base de datos SQLite (local). Se crea automáticamente en backend/db.sqlite3.
# En producción: corre `python manage.py migrate` y luego siembra el admin:
#   python scripts/create_app_admin.py

# reCAPTCHA v2.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Opcional
JWT_ACCESS_TOKEN_LIFETIME=24

# Correo saliente (recuperación de contraseña).
# Sin configurar, Django imprime el correo en la consola del servidor (dev).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- Opción A (RECOMENDADA, gratis, sin SMTP): API HTTP de Brevo ---
# Crea una cuenta gratis en https://www.brevo.com (300 correos/día, sin tarjeta),
# verifica tu correo remitente y copia la API key de "SMTP & API".
# Funciona donde el SMTP está bloqueado (p. ej. PythonAnywhere gratis).
# EMAIL_BACKEND=apps.email_api.EmailBackendAPI
# EMAIL_API_PROVIDER=brevo
# EMAIL_API_KEY=tu-api-key-de-brevo
# DEFAULT_FROM_EMAIL=Orbit <tu-correo-verificado@gmail.com>

# --- Opción B (SMTP directo): Gmail u otro proveedor ---
# En Gmail requiere verificación en 2 pasos y una "contraseña de aplicación".
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tucorreo@gmail.com
# EMAIL_HOST_PASSWORD=tu-contrasena-de-aplicacion
# DEFAULT_FROM_EMAIL=Orbit <tucorreo@gmail.com>

# URL base del frontend (para el enlace que llega por correo)
FRONTEND_URL=http://localhost:5500

# Restablecimiento de contraseña
RESTABLECIMIENTO_TOKEN_MINUTOS=30
RESTABLECIMIENTO_REINTENTO_SEGUNDOS=120
