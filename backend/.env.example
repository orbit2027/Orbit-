# Django
SECRET_KEY=pon-una-clave-larga-y-aleatoria
DEBUG=True
# En producción DEBE incluir tu dominio: tucuenta.pythonanywhere.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend servido localmente
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Base de datos SQLite (local). Se crea automáticamente en backend/db.sqlite3.
# En producción: corre `python manage.py migrate` y luego siembra el admin:
#   python scripts/create_app_admin.py

# CAPTCHA SVG local (sin servicios externos). En producción pon True.
CAPTCHA_HABILITADO=False
# Minutos de validez del código del captcha (por defecto 10).
CAPTCHA_EXPIRACION_MINUTOS=10

# Opcional
JWT_ACCESS_TOKEN_LIFETIME=24

# Correo saliente (recuperación de contraseña).
# Sin configurar, Django imprime el correo en la consola del servidor (dev).
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
#
# Con Brevo (gratuito, sin SMTP, 300 correos/día):
# EMAIL_BACKEND=apps.email.backend.EmailBackendAPI
# EMAIL_API_PROVIDER=brevo
# EMAIL_API_KEY=xkeysib-tu-clave-de-brevo
# DEFAULT_FROM_EMAIL=Orbit <tu-correo-verificado-en-brevo>
#
# Con Resend:
# EMAIL_BACKEND=apps.email.backend.EmailBackendAPI
# EMAIL_API_PROVIDER=resend
# EMAIL_API_KEY=re_tu-clave-de-resend
# DEFAULT_FROM_EMAIL=Orbit <tu-correo-verificado-en-resend>



# URL base del frontend (para el enlace que llega por correo)
FRONTEND_URL=http://localhost:5500

# Restablecimiento de contraseña
RESTABLECIMIENTO_TOKEN_MINUTOS=30
RESTABLECIMIENTO_REINTENTO_SEGUNDOS=120
