# Django
SECRET_KEY=pon-una-clave-larga-y-aleatoria
DEBUG=True
# En producción DEBE incluir tu dominio: tucuenta.pythonanywhere.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend servido localmente
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Base de datos SQLite (local). Se crea automáticamente en backend/db.sqlite3.
# En producción: corre `python manage.py migrate` y luego siembra el admin:
#   python scripts/create_app_admin.py

# reCAPTCHA v2.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Opcional
JWT_ACCESS_TOKEN_LIFETIME=24
